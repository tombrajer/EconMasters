  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "devDependencies": { "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "6.1.1", "typescript": "7.0.2", "vite": "8.3.2" }
}
